#!/bin/sh

THRESHOLD=15
ICON="battery-caution"

BATTERY_INFO=$(upower -i $(upower -e | grep BAT) | grep -E "percentage|state")
BATTERY_PERCENT=$(echo "$BATTERY_INFO" | grep percentage | awk '{print $2}' | sed 's/%//')
BATTERY_STATE=$(echo "$BATTERY_INFO" | grep state | awk '{print $2}')

if [[ "$BATTERY_STATE" == "discharging" && "$BATTERY_PERCENT" -le "$THRESHOLD" ]]; then
	notify-send -u critical -i "$ICON" "Low Battery" "Battery is at ${BATTERY_PERCENT}%!"
fi
