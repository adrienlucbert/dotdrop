#!/bin/sh

usage_and_exit() {
	(
		echo "VPN manager"
		echo ""
		echo "Usage: $(basename "$0") COMMAND [ARGS...]"
		echo "
	-h, --help|print this help
	list|List known VPN solutions
	current|Print the currently active VPN solution, if any
	status [NAME]|Show state of the VPN solution by NAME (defaults to all VPN)
	switch [NAME]|Switch to the VPN solution by NAME (if none, prompts using fzf), stopping other(s)
	start [NAME]|Start the VPN solution by NAME (if none, prompts using fzf)
	stop [NAME]|Stop the VPN solution by NAME (defaults to all VPN)
	" | column -t -s '|'
	) >&2
	exit "${1:-1}"
}

error_unknown_vpn() {
	echo "Unknown VPN: \"$@\"" >&2
	exit 1
}

pick_vpn() {
	list | fzf --select-1 | sed 's/ (current)$//'
}

list() {
	current=$(current)
	[ "$current" = "tailscale" ] && echo "tailscale (current)" || echo "tailscale"
}

current() {
	(status_tailscale >/dev/null 2>&1) && {
		echo tailscale
		return 0
	}
	return 1
}

status() {
	vpn=$1
	case "$vpn" in
	"tailscale")
		(status_tailscale)
		exit $?
		;;
	"")
		ok=0

		status=$(status_tailscale 2>&1)
		[ $? -eq 0 ] && {
			printf "🟢 "
			ok=1
		} || printf "🔴 "
		printf "\033[1mtailscale\033[0m\n$status\n\n"

		[ $ok -eq 0 ] && return 1 || return 0
		;;
	*)
		error_unknown_vpn $vpn
		;;
	esac
}

switch() {
	vpn=$1
	[ -z "$vpn" ] && vpn=$(pick_vpn) || return 1
	(stop >/dev/null 2>&1)
	case "$vpn" in
	"tailscale")
		(start_tailscale)
		exit $?
		;;
	*)
		error_unknown_vpn "$vpn"
		;;
	esac
}

start() {
	vpn=$1
	[ -z "$vpn" ] && vpn=$(pick_vpn) || return 1
	case "$vpn" in
	"tailscale")
		(start_tailscale)
		;;
	*)
		error_unknown_vpn $vpn
		;;
	esac
}

restart() {
	vpn=$1
	[ -z "$vpn" ] && vpn=$(current || pick_vpn) || exit 1
	case "$vpn" in
	"tailscale")
		(stop_tailscale >/dev/null 2>&1)
		(start_tailscale)
		;;
	*)
		error_unknown_vpn $vpn
		;;
	esac
}

stop() {
	vpn=$1
	case "$vpn" in
	"tailscale")
		(stop_tailscale)
		return $?
		;;
	"")
		rc=0
		(stop_tailscale) || rc=1
		return $rc
		;;
	*)
		error_unknown_vpn $vpn
		;;
	esac
}

start_tailscale() {
	sudo tailscale up
}
stop_tailscale() {
	sudo tailscale down
}
status_tailscale() {
	tailscale status
}

while [ $# -gt 0 ]; do
	case "$1" in
	-h | --help) usage_and_exit 0 ;;
	list)
		shift
		list
		exit $?
		;;
	current)
		shift
		current
		exit $?
		;;
	status)
		shift
		status "$@"
		exit $?
		;;
	switch)
		shift
		switch "$@"
		exit $?
		;;
	start)
		shift
		start "$@"
		exit $?
		;;
	restart)
		shift
		restart "$@"
		exit $?
		;;
	stop)
		shift
		stop "$@"
		exit $?
		;;
	*)
		usage_and_exit 1
		;;
	esac
done

list
